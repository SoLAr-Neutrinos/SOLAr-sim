{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",

  "$defs": {
    "val_w_unit": {
      "description": "A scalar with a physical unit, as consumed by unit::ParseJsonVal.",
      "type": "object",
      "required": ["val", "unit"],
      "additionalProperties": false,
      "properties": {
        "val":  { "type": "number" },
        "unit": { "type": "string" }
      }
    },

    "named_val_w_unit": {
      "description": "A named scalar parameter, as used in dimensions arrays.",
      "type": "object",
      "required": ["name", "val"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "val":  { "type": "number" },
        "unit": { "type": "string" }
      }
    },

    "dimensions": {
      "description": "Array of named geometry parameters read by fGeoInfo->ReadFromJSON.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/named_val_w_unit" }
    },

    "vec3" : {
      "description": "A simple 3D vector",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },

    "vec3_w_unit": {
      "type": "object",
      "required": ["unit", "xyz"],
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string" },
        "xyz": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },

    "rot3_w_unit": {
      "type": "object",
      "required": ["unit", "val"],
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string" },
        "val": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },

    "base_material": {
      "description": "Material name used as the base for a volume or layer.",
      "type": "string"
    },

     "material_entry": {
      "description": "A material assignment for a module.",
      "type": "object",
      "required": ["module", "material"],
      "properties": {
        "module": { "type": "string" },
        "material": { "type": "string" }
      },
      "additionalProperties": false
    },

    "materials": {
      "description": "Array of material assignments for modules. Must include a module with value 'base_material'.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material_entry" },
      "contains": {
        "type": "object",
        "required": ["module", "material"],
        "properties": {
          "module": { "const": "base_material" },
          "material": { "$ref": "#/$defs/base_material" }
        }
      }
    } 
  }
}
